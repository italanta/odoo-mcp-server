{
  "manifest_version": "0.4",
  "name": "odoo-mcp-server",
  "display_name": "Odoo MCP Server",
  "version": "0.1.0",
  "description": "Give Claude safe local access to your Odoo CRM and projects so it can search records, review context, draft approved updates, and log internal notes, while blocking deletes and external messages.",
  "icon": "assets/logo.png",
  "author": {
    "name": "Elewa"
  },
  "server": {
    "type": "uv",
    "entry_point": "src/mcp/odoo/server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "src/mcp/odoo/server.py"
      ],
      "env": {
        "ODOO_TRANSPORT": "${user_config.odoo_transport}"
      }
    }
  },
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "python": ">=3.11"
    }
  },
  "user_config": {
    "odoo_transport": {
      "type": "string",
      "title": "Odoo transport",
      "description": "Choose xmlrpc for Odoo 18 and below, or json2 for Odoo 19 and above.",
      "required": true,
      "default": "json2"
    }
  },
  "tools_generated": true,
  "keywords": [
    "odoo",
    "mcp",
    "crm",
    "projects"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/italanta/odoo-mcp-server"
  }
}